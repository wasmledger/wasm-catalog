{
  "name": "@sik/wasm-catalog-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Static browser for the wasm-catalog mainnet census: every Soroban contract code by wasm hash, its interface, bindings, clusters and SEP adoption.",
  "scripts": {
    "demo:data": "node ../scripts/web-data.ts",
    "dev": "vite",
    "build": "node scripts/check-data.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": { "node": ">=22.18" },
  "packageManager": "pnpm@10.22.0"
}
